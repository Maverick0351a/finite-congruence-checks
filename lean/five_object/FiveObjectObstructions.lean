/-- Covers all 3125 unary maps; arbitrary functions enter through table_complete. -/
theorem profile_certificate : ∀ a b c d e : V,
    PreservesFamily theta (table (a,b,c,d,e)) → AllowedProfile (profile (table (a,b,c,d,e))) := by
  intro a b c
  rcases fin5_cases a with rfl | rfl | rfl | rfl | rfl
  all_goals rcases fin5_cases b with rfl | rfl | rfl | rfl | rfl
  all_goals rcases fin5_cases c with rfl | rfl | rfl | rfl | rfl
